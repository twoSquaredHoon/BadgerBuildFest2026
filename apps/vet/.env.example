# Copy this file to .env and fill in the values from
# Supabase → Project Settings → API Keys (see docs/backend-setup.md).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_), or the legacy "anon" key.
# Never put the secret / service_role key here: this file ships to phones.
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
